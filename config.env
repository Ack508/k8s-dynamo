# 在可用管理员 kubeconfig 的管理机上运行 deploy.sh。环境变量优先于本文件默认值。
export DYNAMO_VERSION="${DYNAMO_VERSION:-1.6.0}"
export NAMESPACE="${NAMESPACE:-dynamo-system}"
export DGD_NAME="${DGD_NAME:-qwen3-0-6b}"
export API_SERVICE="${API_SERVICE:-qwen3-api}"
# 这里只填部署 Frontend、Worker 的节点。专用 CPU 控制节点无需加入。
export NODE_NAMES="${NODE_NAMES:-a100-1,a100-2}"
export NODE_IPS="${NODE_IPS:-10.1.22.129,10.1.22.130}"
export NODE_PORT="${NODE_PORT:-30080}"
export MODEL_HOST_PATH="${MODEL_HOST_PATH:-/data0/models/qwen3-0.6B}"
export SERVED_MODEL="${SERVED_MODEL:-Qwen/Qwen3-0.6B}"
export WORKER_REPLICAS="${WORKER_REPLICAS:-16}"
# 每个 Worker 固定使用一张 GPU，TP=1，P/D 共置。
# 0.80 是权重 + KV Cache 内存池预算；80 GiB A100 实测总占用约 64.5 GiB。
export MEM_FRACTION_STATIC="${MEM_FRACTION_STATIC:-0.80}"
export MAX_RUNNING_REQUESTS="${MAX_RUNNING_REQUESTS:-64}"
export CUDA_GRAPH_MAX_BS="${CUDA_GRAPH_MAX_BS:-64}"
export WAIT_TIMEOUT="${WAIT_TIMEOUT:-15m}"
